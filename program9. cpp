#include <iostream>
using namespace std;

int main()
{
    float distance, waiting, fare;
    int hour, premium, cancel;

    cout << "Enter distance: ";
    cin >> distance;

    cout << "Enter waiting minutes: ";
    cin >> waiting;

    cout << "Enter ride starting hour (0-23): ";
    cin >> hour;

    cout << "Premium member? (1=Yes, 0=No): ";
    cin >> premium;

    cout << "Driver cancelled? (1=Yes, 0=No): ";
    cin >> cancel;

    if (cancel == 1)
        cout << "Driver Penalty = Rs. 300";
    else
    {
        fare = 150 + distance * 50 + waiting * 10;

        if (hour >= 22 || hour < 6)
            fare += fare * 0.20;

        if (premium == 1)
            fare -= fare * 0.10;

        cout << "Final Fare = Rs. " << fare;
    }

    return 0;
}